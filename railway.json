{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "mvn -q exec:java -Dexec.mainClass=com.eldsolution.FirstScript -Dexec.cleanupDaemonThreads=false",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
